+// isHandshakeInitiation reports whether buf is a WireGuard handshake initiation
+// message (type 1, fixed length of 148 bytes). Must be called before the
+// reserved bytes overwrite buf[1:4].
+func isHandshakeInitiation(buf []byte) bool {
+	return len(buf) == 148 && buf[0] == 1 && buf[1] == 0 && buf[2] == 0 && buf[3] == 0
+}
+
+// sendJunk sends junkCount random packets of junkMin..junkMax bytes to the peer.
+// First byte is always >= 5 so junk can never be mistaken for a WG message type.
+func (b *bind) sendJunk(c net.PacketConn, ep conn.Endpoint) {
+	stdEp, ok := ep.(*conn.StdNetEndpoint)
+	if !ok {
+		return
+	}
+	addr := net.UDPAddrFromAddrPort(stdEp.AddrPort)
+	for n := uint32(0); n < b.junkCount; n++ {
+		size := int(b.junkMin)
+		if b.junkMax > b.junkMin {
+			size += rand.IntN(int(b.junkMax-b.junkMin) + 1)
+		}
+		if size < 1 {
+			continue
+		}
+		pkt := make([]byte, size)
+		if _, err := crand.Read(pkt); err != nil {
+			return
+		}
+		if pkt[0] < 5 {
+			pkt[0] += 5
+		}
+		_, _ = c.WriteTo(pkt, addr)
+	}
+}
