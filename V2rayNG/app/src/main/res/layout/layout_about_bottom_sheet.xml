<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="?android:attr/colorBackground">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_label_about"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorPrimary" />

    <TextView
        android:id="@+id/tv_version"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="?android:attr/textColorSecondary"
        android:layout_marginBottom="16dp" />

    <TextView

        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/about_app_description"
        android:textSize="14sp"
        android:textColor="?android:attr/textColorSecondary"
        android:lineSpacingExtra="4dp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/about_app_license"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorSecondary"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/about_app_tg_channel"
        android:textSize="14sp"
        android:textColor="?android:attr/textColorSecondary" />
        
    <TextView
        android:id="@+id/tv_link_tg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="https://t.me/NullCoreDeveloper"
        android:textSize="14sp"
        android:textColor="?android:attr/textColorLink"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/about_app_source_code"
        android:textSize="14sp"
        android:textColor="?android:attr/textColorSecondary" />
        
    <TextView
        android:id="@+id/tv_link_repo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="https://github.com/NullCoreDeveloper/v2whitelist"
        android:textSize="14sp"
        android:textColor="?android:attr/textColorLink"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/about_app_dev_profile"
        android:textSize="14sp"
        android:textColor="?android:attr/textColorSecondary" />
        
    <TextView
        android:id="@+id/tv_link_profile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="https://github.com/NullCoreDeveloper"
        android:textSize="14sp"
        android:textColor="?android:attr/textColorLink"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginBottom="12dp" />

</LinearLayout>
