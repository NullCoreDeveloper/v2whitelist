<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Управление подписками (всегда вверху) -->
    <PreferenceCategory android:title="@string/title_v2whitelist_settings">
        <Preference
            android:key="pref_manage_custom_subs"
            android:summary="@string/summary_pref_manage_subs"
            android:title="@string/title_pref_manage_subs" />

        <Preference
            android:key="pref_subscription_setup_wizard"
            android:summary="@string/summary_subscription_setup_wizard"
            android:title="@string/title_subscription_setup_wizard" />
    </PreferenceCategory>

    <!-- 1. ⚡ Сканер и ядро v2w-core -->
    <PreferenceCategory android:title="@string/title_category_scanner_and_core">
        <SwitchPreference
            android:key="pref_filter_insecure_profiles"
            android:title="Удалять небезопасные профили"
            android:summary="Не пропускать в балансировщике и удалить профили без шифрования (без TLS/Reality или с allowInsecure)"
            android:defaultValue="false" />

        <EditTextPreference
            android:inputType="number"
            android:key="pref_chunk_size"
            android:defaultValue="20"
            android:summary="@string/summary_pref_chunk_size"
            android:title="@string/title_pref_chunk_size" />

        <ListPreference
            android:defaultValue="equal"
            android:entries="@array/chunk_preset_entries"
            android:entryValues="@array/chunk_preset_values"
            android:key="pref_chunk_preset"
            android:summary="%s"
            android:title="@string/title_pref_chunk_preset" />

        <CheckBoxPreference
            android:key="pref_v2w_core_enabled"
            android:defaultValue="true"
            android:summary="@string/summary_pref_v2w_core_enabled"
            android:title="@string/title_pref_v2w_core_enabled" />

        <CheckBoxPreference
            android:key="pref_v2w_core_fallback"
            android:defaultValue="true"
            android:dependency="pref_v2w_core_enabled"
            android:summary="@string/summary_pref_v2w_core_fallback"
            android:title="@string/title_pref_v2w_core_fallback" />

        <EditTextPreference
            android:inputType="number"
            android:key="pref_v2w_core_concurrency"
            android:defaultValue="35"
            android:summary="@string/summary_pref_v2w_core_concurrency"
            android:title="@string/title_pref_v2w_core_concurrency" />
    </PreferenceCategory>

    <!-- 2. 🛡️ Проверка профилей и сервисов -->
    <PreferenceCategory android:title="@string/title_category_profile_check">
        <CheckBoxPreference
            android:key="pref_profile_check_enabled"
            android:defaultValue="true"
            android:summary="@string/summary_pref_profile_check"
            android:title="@string/title_pref_profile_check" />

        <CheckBoxPreference
            android:key="pref_service_check_enabled"
            android:defaultValue="false"
            android:summary="@string/summary_pref_service_check"
            android:title="@string/title_pref_service_check" />

        <Preference
            android:key="pref_service_check_config"
            android:summary="@string/summary_pref_service_check_config"
            android:title="@string/title_pref_service_check_config" />

        <CheckBoxPreference
            android:key="pref_endpoint_e2e_check_enabled"
            android:defaultValue="true"
            android:summary="@string/summary_pref_endpoint_e2e_check_enabled"
            android:title="@string/title_pref_endpoint_e2e_check_enabled" />

        <CheckBoxPreference
            android:key="pref_profile_speed_check_enabled"
            android:defaultValue="true"
            android:summary="@string/summary_pref_profile_speed_check"
            android:title="@string/title_pref_profile_speed_check" />

        <EditTextPreference
            android:inputType="number"
            android:key="pref_profile_speed_check_bytes"
            android:defaultValue="2000000"
            android:summary="@string/summary_pref_profile_speed_check_bytes"
            android:title="@string/title_pref_profile_speed_check_bytes" />

        <EditTextPreference
            android:inputType="number"
            android:key="pref_profile_speed_check_timeout_ms"
            android:defaultValue="3000"
            android:summary="@string/summary_pref_profile_speed_check_timeout"
            android:title="@string/title_pref_profile_speed_check_timeout" />

        <EditTextPreference
            android:inputType="numberDecimal"
            android:key="pref_profile_min_speed_mbps"
            android:defaultValue="1.0"
            android:summary="@string/summary_pref_profile_min_speed_mbps"
            android:title="@string/title_pref_profile_min_speed_mbps" />

        <EditTextPreference
            android:inputType="number"
            android:key="pref_vip_cache_limit"
            android:defaultValue="5"
            android:summary="@string/summary_pref_vip_cache_limit"
            android:title="@string/title_pref_vip_cache_limit" />
    </PreferenceCategory>

    <!-- 3. 🔄 Авто-переключение (Failover) -->
    <PreferenceCategory android:title="@string/title_category_failover">
        <CheckBoxPreference
            android:key="pref_auto_failover"
            android:defaultValue="false"
            android:summary="@string/summary_pref_auto_failover"
            android:title="@string/title_pref_auto_failover" />

        <EditTextPreference
            android:dependency="pref_auto_failover"
            android:inputType="number"
            android:key="pref_auto_failover_interval_sec"
            android:defaultValue="30"
            android:summary="@string/summary_pref_auto_failover_interval"
            android:title="@string/title_pref_auto_failover_interval" />

        <CheckBoxPreference
            android:dependency="pref_auto_failover"
            android:key="pref_smart_failover_enabled"
            android:defaultValue="false"
            android:summary="@string/summary_pref_smart_failover"
            android:title="@string/title_pref_smart_failover" />

        <EditTextPreference
            android:dependency="pref_smart_failover_enabled"
            android:inputType="number"
            android:key="pref_smart_failover_threshold_kbps"
            android:defaultValue="3"
            android:summary="@string/summary_pref_smart_failover_threshold"
            android:title="@string/title_pref_smart_failover_threshold" />

        <EditTextPreference
            android:dependency="pref_smart_failover_enabled"
            android:inputType="number"
            android:key="pref_smart_failover_stall_sec"
            android:defaultValue="3"
            android:summary="@string/summary_pref_smart_failover_stall"
            android:title="@string/title_pref_smart_failover_stall" />

        <CheckBoxPreference
            android:key="pref_network_check_enabled"
            android:defaultValue="true"
            android:summary="@string/summary_pref_network_check_enabled"
            android:title="@string/title_pref_network_check_enabled" />

        <EditTextPreference
            android:dependency="pref_network_check_enabled"
            android:key="pref_network_check_url_1"
            android:defaultValue="google.com"
            android:summary="@string/summary_pref_network_check_url_1"
            android:title="@string/title_pref_network_check_url_1" />

        <EditTextPreference
            android:dependency="pref_network_check_enabled"
            android:key="pref_network_check_url_2"
            android:defaultValue="ya.ru"
            android:summary="@string/summary_pref_network_check_url_2"
            android:title="@string/title_pref_network_check_url_2" />
    </PreferenceCategory>

    <!-- 4. 📦 Фоновое обновление -->
    <PreferenceCategory android:title="@string/title_category_updates">
        <CheckBoxPreference
            android:key="pref_auto_update_subscription"
            android:summary="@string/summary_pref_auto_update_subscription"
            android:title="@string/title_pref_auto_update_subscription" />

        <EditTextPreference
            android:inputType="number"
            android:key="pref_auto_update_interval"
            android:summary="60"
            android:title="@string/title_pref_auto_update_interval" />

        <CheckBoxPreference
            android:key="pref_update_sub_only_via_vpn"
            android:defaultValue="false"
            android:summary="@string/summary_pref_update_sub_only_via_vpn"
            android:title="@string/title_pref_update_sub_only_via_vpn" />

        <EditTextPreference
            android:inputType="number"
            android:key="pref_sub_concurrency"
            android:defaultValue="3"
            android:summary="@string/summary_pref_sub_concurrency"
            android:title="@string/title_pref_sub_concurrency" />

        <Preference
            android:key="pref_check_update_now"
            android:summary="@string/summary_pref_check_update_now"
            android:title="@string/title_pref_check_update_now" />

        <CheckBoxPreference
            android:key="pref_update_via_yandex_on_bs"
            android:defaultValue="false"
            android:summary="@string/summary_pref_update_via_yandex_on_bs"
            android:title="@string/title_pref_update_via_yandex_on_bs" />

        <Preference
            android:key="pref_test_update_via_yandex"
            android:summary="@string/summary_pref_debug_update_via_yandex"
            android:title="@string/title_pref_debug_update_via_yandex" />

        <Preference
            android:key="pref_clear_yandex_cookies"
            android:summary="@string/summary_pref_clear_yandex_cookies"
            android:title="@string/title_pref_clear_yandex_cookies" />

        <CheckBoxPreference
            android:key="pref_auto_check_update"
            android:defaultValue="true"
            android:summary="@string/summary_pref_auto_check_update"
            android:title="@string/title_pref_auto_check_update" />

        <CheckBoxPreference
            android:key="pref_check_update_pre_release"
            android:defaultValue="false"
            android:summary="@string/summary_pref_check_update_pre_release"
            android:title="@string/title_pref_check_update_pre_release" />

        <EditTextPreference
            android:key="pref_custom_user_agent"
            android:summary="@string/summary_pref_custom_user_agent"
            android:title="@string/title_pref_custom_user_agent" />
    </PreferenceCategory>

    <!-- 5. 🌐 Маршрутизация и Proxy-каскад -->
    <PreferenceCategory android:title="@string/title_category_routing">
        <CheckBoxPreference
            android:key="pref_bypass_ru_apps"
            android:defaultValue="true"
            android:summary="@string/summary_pref_bypass_ru_apps"
            android:title="@string/title_pref_bypass_ru_apps" />

        <CheckBoxPreference
            android:key="pref_per_app_proxy"
            android:summary="@string/summary_pref_per_app_proxy"
            android:title="@string/title_pref_per_app_proxy" />

        <Preference
            android:key="pref_per_app_proxy_settings"
            android:summary="@string/summary_pref_per_app_proxy_settings"
            android:title="@string/title_pref_per_app_proxy_settings" />

        <CheckBoxPreference
            android:key="pref_domain_split_tunneling_enabled"
            android:defaultValue="false"
            android:summary="@string/summary_pref_domain_split_tunneling"
            android:title="@string/title_pref_domain_split_tunneling" />

        <CheckBoxPreference
            android:dependency="pref_domain_split_tunneling_enabled"
            android:key="pref_domain_whitelist_mode"
            android:defaultValue="false"
            android:summary="@string/summary_pref_domain_whitelist_mode"
            android:title="@string/title_pref_domain_whitelist_mode" />

        <Preference
            android:dependency="pref_domain_split_tunneling_enabled"
            android:key="pref_proxy_domain_list_settings"
            android:summary="@string/summary_pref_proxy_domain_list_settings"
            android:title="@string/title_pref_proxy_domain_list_settings" />

        <Preference
            android:dependency="pref_domain_split_tunneling_enabled"
            android:key="pref_domain_split_tunneling_settings"
            android:summary="@string/summary_pref_domain_split_tunneling_settings"
            android:title="@string/title_pref_domain_split_tunneling_settings" />

        <Preference
            android:dependency="pref_domain_split_tunneling_enabled"
            android:key="pref_domain_geo_files"
            android:summary="@string/summary_pref_domain_geo_files"
            android:title="@string/title_pref_domain_geo_files" />

        <CheckBoxPreference
            android:key="pref_custom_endpoint_enabled"
            android:defaultValue="false"
            android:summary="@string/summary_pref_custom_endpoint_enabled"
            android:title="@string/title_pref_custom_endpoint_enabled" />

        <EditTextPreference
            android:key="pref_custom_endpoint_sub_url"
            android:summary="@string/summary_pref_custom_endpoint_sub_url"
            android:title="@string/title_pref_custom_endpoint_sub_url" />

        <androidx.preference.Preference
            android:key="pref_custom_endpoint_select_server"
            android:summary="@string/summary_pref_custom_endpoint_select_server"
            android:title="@string/title_pref_custom_endpoint_select_server" />

        <EditTextPreference
            android:key="pref_custom_endpoint_url"
            android:summary="@string/summary_pref_custom_endpoint_url"
            android:title="@string/title_pref_custom_endpoint_url" />
    </PreferenceCategory>

    <!-- 6. ⚙️ Параметры VPN и ядра -->
    <PreferenceCategory android:title="@string/title_category_vpn_core">
        <ListPreference
            android:defaultValue="VPN"
            android:entries="@array/mode_entries"
            android:entryValues="@array/mode_value"
            android:key="pref_mode"
            android:summary="%s"
            android:title="@string/title_mode" />

        <Preference
            android:key="pref_appearance_settings"
            android:summary="@string/summary_appearance_settings"
            android:title="@string/title_appearance_settings" />

        <CheckBoxPreference
            android:key="pref_speed_enabled"
            android:summary="@string/summary_pref_speed_enabled"
            android:title="@string/title_pref_speed_enabled" />

        <CheckBoxPreference
            android:key="pref_confirm_remove"
            android:summary="@string/summary_pref_confirm_remove"
            android:title="@string/title_pref_confirm_remove" />

        <CheckBoxPreference
            android:key="pref_start_scan_immediate"
            android:summary="@string/summary_pref_start_scan_immediate"
            android:title="@string/title_pref_start_scan_immediate" />

        <CheckBoxPreference
            android:key="pref_prefer_ipv6"
            android:summary="@string/summary_pref_prefer_ipv6"
            android:title="@string/title_pref_prefer_ipv6" />

        <CheckBoxPreference
            android:key="pref_local_dns_enabled"
            android:summary="@string/summary_pref_local_dns_enabled"
            android:title="@string/title_pref_local_dns_enabled" />

        <CheckBoxPreference
            android:key="pref_fake_dns_enabled"
            android:summary="@string/summary_pref_fake_dns_enabled"
            android:title="@string/title_pref_fake_dns_enabled" />

        <CheckBoxPreference
            android:key="pref_append_http_proxy"
            android:summary="@string/summary_pref_append_http_proxy"
            android:title="@string/title_pref_append_http_proxy" />

        <EditTextPreference
            android:key="pref_vpn_dns"
            android:summary="@string/summary_pref_remote_dns"
            android:title="@string/title_pref_vpn_dns" />

        <ListPreference
            android:defaultValue="1"
            android:entries="@array/vpn_bypass_lan"
            android:entryValues="@array/vpn_bypass_lan_value"
            android:key="pref_vpn_bypass_lan"
            android:summary="%s"
            android:title="@string/title_pref_vpn_bypass_lan" />

        <ListPreference
            android:defaultValue="0"
            android:entries="@array/vpn_interface_address"
            android:entryValues="@array/vpn_interface_address_value"
            android:key="pref_vpn_interface_address_config_index"
            android:summary="%s"
            android:title="@string/title_pref_vpn_interface_address" />

        <EditTextPreference
            android:inputType="number"
            android:key="pref_vpn_mtu"
            android:summary="1500"
            android:title="@string/title_pref_vpn_mtu" />

        <CheckBoxPreference
            android:defaultValue="true"
            android:key="pref_sniffing_enabled"
            android:summary="@string/summary_pref_sniffing_enabled"
            android:title="@string/title_pref_sniffing_enabled" />

        <CheckBoxPreference
            android:defaultValue="false"
            android:key="pref_route_only_enabled"
            android:summary="@string/summary_pref_route_only_enabled"
            android:title="@string/title_pref_route_only_enabled" />

        <CheckBoxPreference
            android:defaultValue="false"
            android:key="pref_proxy_sharing_enabled"
            android:summary="@string/summary_pref_proxy_sharing_enabled"
            android:title="@string/title_pref_proxy_sharing_enabled" />

        <CheckBoxPreference
            android:defaultValue="false"
            android:key="pref_allow_insecure"
            android:summary="@string/summary_pref_allow_insecure"
            android:title="@string/title_pref_allow_insecure" />

        <EditTextPreference
            android:inputType="number"
            android:key="pref_socks_port"
            android:summary="10808"
            android:title="@string/title_pref_socks_port" />

        <EditTextPreference
            android:key="pref_socks_user"
            android:title="Логин локального прокси (SOCKS5/HTTP)"
            android:summary="Оставьте пустым для автогенерации (рекомендуется)" />

        <EditTextPreference
            android:key="pref_socks_pass"
            android:title="Пароль локального прокси (SOCKS5/HTTP)"
            android:summary="Оставьте пустым для автогенерации (рекомендуется)" />

        <EditTextPreference
            android:key="pref_remote_dns"
            android:summary="@string/summary_pref_remote_dns"
            android:title="@string/title_pref_remote_dns" />

        <EditTextPreference
            android:key="pref_domestic_dns"
            android:summary="@string/summary_pref_domestic_dns"
            android:title="@string/title_pref_domestic_dns" />

        <EditTextPreference
            android:key="pref_dns_hosts"
            android:summary="@string/summary_pref_dns_hosts"
            android:title="@string/title_pref_dns_hosts" />

        <ListPreference
            android:defaultValue="warning"
            android:entries="@array/core_loglevel"
            android:entryValues="@array/core_loglevel"
            android:key="pref_core_loglevel"
            android:summary="%s"
            android:title="@string/title_core_loglevel" />

        <ListPreference
            android:defaultValue="1"
            android:entries="@array/outbound_domain_resolve_method"
            android:entryValues="@array/outbound_domain_resolve_method_value"
            android:key="pref_outbound_domain_resolve_method"
            android:summary="%s"
            android:title="@string/title_outbound_domain_resolve_method" />

        <CheckBoxPreference
            android:key="pref_mux_enabled"
            android:summary="@string/summary_pref_mux_enabled"
            android:title="@string/title_pref_mux_enabled" />

        <EditTextPreference
            android:inputType="number"
            android:key="pref_mux_concurrency"
            android:summary="8"
            android:title="@string/title_pref_mux_concurency" />

        <EditTextPreference
            android:inputType="number"
            android:key="pref_mux_xudp_concurrency"
            android:summary="8"
            android:title="@string/title_pref_mux_xudp_concurency" />

        <ListPreference
            android:defaultValue="reject"
            android:entries="@array/mux_xudp_quic_entries"
            android:entryValues="@array/mux_xudp_quic_value"
            android:key="pref_mux_xudp_quic"
            android:summary="%s"
            android:title="@string/title_pref_mux_xudp_quic" />

        <CheckBoxPreference
            android:key="pref_fragment_enabled"
            android:title="@string/title_pref_fragment_enabled" />

        <EditTextPreference
            android:key="pref_fragment_length"
            android:summary="50-100"
            android:title="@string/title_pref_fragment_length" />

        <EditTextPreference
            android:key="pref_fragment_interval"
            android:summary="10-20"
            android:title="@string/title_pref_fragment_interval" />

        <ListPreference
            android:defaultValue="tlshello"
            android:entries="@array/fragment_packets"
            android:entryValues="@array/fragment_packets"
            android:key="pref_fragment_packets"
            android:summary="%s"
            android:title="@string/title_pref_fragment_packets" />
    </PreferenceCategory>

    <!-- 7. 💾 Резервное копирование и система -->
    <PreferenceCategory android:title="@string/title_category_backup_system">
        <CheckBoxPreference
            android:key="pref_is_booted"
            android:summary="@string/summary_pref_is_booted"
            android:title="@string/title_pref_is_booted" />

        <EditTextPreference
            android:key="pref_delay_test_url"
            android:summary="@string/summary_pref_delay_test_url"
            android:title="@string/title_pref_delay_test_url" />

        <EditTextPreference
            android:key="pref_ip_api_url"
            android:summary="@string/summary_pref_ip_api_url"
            android:title="@string/title_pref_ip_api_url" />

        <Preference
            android:key="pref_logcat"
            android:summary="@string/summary_pref_logcat"
            android:title="@string/title_pref_logcat" />

        <Preference
            android:key="pref_export_data"
            android:summary="@string/summary_export_data"
            android:title="@string/title_export_data" />

        <Preference
            android:key="pref_import_data"
            android:summary="@string/summary_import_data"
            android:title="@string/title_import_data" />
    </PreferenceCategory>

</PreferenceScreen>
